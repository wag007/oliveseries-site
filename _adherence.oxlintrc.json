{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/icons/**",
              "components/layout/**",
              "components/media/**",
              "components/tiles/**",
              "components/type/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Nunito))/i]",
        "message": "Font not provided by the design system. Available: Inter, Nunito."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColorDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|size|label|style|key|ref|className|style|children)$/]",
        "message": "<ColorDot> doesn't accept that prop. Declared props: color, size, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColorTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|textColor|height|style|key|ref|className|style|children)$/]",
        "message": "<ColorTile> doesn't accept that prop. Declared props: children, color, textColor, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FactRowItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<FactRowItem> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:arrow-up-right|close)$/]",
        "message": "<Icon> name must be one of 'arrow-up-right' | 'close'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|color|textColor|src|height|style|key|ref|className|style|children)$/]",
        "message": "<LinkTile> doesn't accept that prop. Declared props: children, href, color, textColor, src, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|onClick|key|ref|className|style|children)$/]",
        "message": "<NavBarItem> doesn't accept that prop. Declared props: label, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='NewsletterBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|style|key|ref|className|style|children)$/]",
        "message": "<NewsletterBar> doesn't accept that prop. Declared props: children, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ObjectTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|color|title|meta|textColor|fit|height|style|key|ref|className|style|children)$/]",
        "message": "<ObjectTile> doesn't accept that prop. Declared props: src, alt, color, title, meta, textColor, fit, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ObjectTile'] > JSXAttribute[name.name='fit'] > Literal[value!=/^(?:contain|cover)$/]",
        "message": "<ObjectTile> fit must be one of 'contain' | 'cover'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Overlay'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|paragraphs|background|style|key|ref|className|style|children)$/]",
        "message": "<Overlay> doesn't accept that prop. Declared props: open, onClose, paragraphs, background, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|tagline|handle|handleHref|style|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: title, tagline, handle, handleHref, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|label|href|size|style|key|ref|className|style|children)$/]",
        "message": "<PhotoLink> doesn't accept that prop. Declared props: src, alt, label, href, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|scrim|height|style|key|ref|className|style|children)$/]",
        "message": "<PhotoTile> doesn't accept that prop. Declared props: src, alt, scrim, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|title|legal|handle|handleHref|style|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: kicker, title, legal, handle, handleHref, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Statement'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|color|align|style|key|ref|className|style|children)$/]",
        "message": "<Statement> doesn't accept that prop. Declared props: children, tone, color, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Statement'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:hard|soft)$/]",
        "message": "<Statement> tone must be one of 'hard' | 'soft'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Statement'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Statement> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TileGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|gap|style|key|ref|className|style|children)$/]",
        "message": "<TileGrid> doesn't accept that prop. Declared props: children, gap, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|color|align|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: children, variant, size, color, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:bubble|heavy)$/]",
        "message": "<Wordmark> variant must be one of 'bubble' | 'heavy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Wordmark> align must be one of 'left' | 'center' | 'right'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
